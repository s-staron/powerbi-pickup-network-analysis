model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters
	annotation PBI_QueryGroupOrder = 0

queryGroup Functions
	annotation PBI_QueryGroupOrder = 1

queryGroup Staging
	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0
annotation PBI_QueryOrder = ["DataFolder", "fnReadCsv", "fnNullIfEmpty", "fnParseTimestamp", "fnParseDate", "stg_Parcels_Raw", "stg_Parcels_Deduped", "stg_PickupPoints_Raw", "stg_CityMapping", "FactParcel", "DimPickupPoint", "DimRegion", "Target", "DimDate", "DQ_Cleaning", "DQ_UnmatchedPoints", "ExpectedResults", "UserRegion"]
annotation PBI_ProTooling = ["DevMode"]

ref table FactParcel
ref table DimPickupPoint
ref table DimRegion
ref table Target
ref table DimDate
ref table DQ_Cleaning
ref table DQ_UnmatchedPoints
ref table ExpectedResults
ref table UserRegion
ref table _Measures
ref table 'Top N'
ref table 'Headline KPI'
ref role 'Regional Manager'
ref expression DataFolder
ref expression fnReadCsv
ref expression fnNullIfEmpty
ref expression fnParseTimestamp
ref expression fnParseDate
ref expression stg_Parcels_Raw
ref expression stg_Parcels_Deduped
ref expression stg_PickupPoints_Raw
ref expression stg_CityMapping
