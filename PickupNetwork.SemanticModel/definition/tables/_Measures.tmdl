/// Measures table. Holds every DAX measure of the model; it has no data. Display folders group the measures by purpose.
table _Measures
	lineageTag: d599687f-5f6e-5865-8168-76cedf26edee

	/// Number of parcels that arrived at a pickup point (duplicates already removed). Basis of every rate.
	measure 'Parcels Arrived' = COUNTROWS(FactParcel)
		formatString: #,##0
		displayFolder: 1 Volumes
		lineageTag: 40582bd4-79a8-591d-8891-84952afbdbee

	/// Parcels that a customer collected.
	measure 'Parcels Collected' = SUM(FactParcel[IsCollected])
		formatString: #,##0
		displayFolder: 1 Volumes
		lineageTag: 9e252ff6-024b-5ef1-aa67-bdf274d8fb96

	/// Parcels that went back to the sender.
	measure 'Parcels Returned' = SUM(FactParcel[IsReturned])
		formatString: #,##0
		displayFolder: 1 Volumes
		lineageTag: 7ca40243-5331-5ecd-87c8-e1e0040d9415

	/// Parcels collected 72 hours or less after arrival.
	measure 'Collected Within 3 Days' = SUM(FactParcel[IsCollectedWithin3Days])
		formatString: #,##0
		displayFolder: 1 Volumes
		lineageTag: 854c120e-b511-5878-a919-e3b9335469c1

	/// Share of arrived parcels that were collected. Every parcel in the export is resolved, so this equals 1 minus the return rate.
	measure 'Pickup Rate' = DIVIDE([Parcels Collected], [Parcels Arrived])
		formatString: 0.0%
		displayFolder: 2 Rates and times
		lineageTag: a79b2dae-3b34-5a44-bb61-f472e7c36f4a

	/// Share of arrived parcels collected within 3 days. Denominator is all arrived parcels, so returns count as misses.
	measure 'Pickup Within 3 Days Rate' = DIVIDE([Collected Within 3 Days], [Parcels Arrived])
		formatString: 0.0%
		displayFolder: 2 Rates and times
		lineageTag: 403cfa84-3867-5b30-bb95-470e185704db

	/// Share of arrived parcels that went back to the sender.
	measure 'Return To Sender Rate' = DIVIDE([Parcels Returned], [Parcels Arrived])
		formatString: 0.0%
		displayFolder: 2 Rates and times
		lineageTag: 23603c30-55f1-5ebc-9a40-a83d6ba8b7b4

	/// Average days from arrival to pickup, collected parcels only.
	measure 'Avg Dwell Days' = CALCULATE(AVERAGE(FactParcel[DwellDays]), FactParcel[IsCollected] = 1)
		formatString: 0.00
		displayFolder: 2 Rates and times
		lineageTag: 6ff67a66-c256-54f1-8247-f6e388cdfc33

	/// Occupied slot-days divided by available slot-days. Occupied = days parcels stayed at known points, counted on the arrival date. Available = capacity times the days in the period since the point opened. Above 100% means demand beyond the nominal capacity.
	measure Utilisation =
			VAR _occupied =
			    CALCULATE(SUM(FactParcel[DwellDays]), DimPickupPoint[IsKnownPoint] = TRUE()) + 0
			VAR _available =
			    SUMX(
			        DimPickupPoint,
			        DimPickupPoint[Capacity]
			            * COUNTROWS(FILTER(VALUES(DimDate[Date]), DimDate[Date] >= DimPickupPoint[OpeningDate]))
			    )
			RETURN
			    DIVIDE(_occupied, _available)
		formatString: 0%
		displayFolder: 3 Capacity
		lineageTag: 71348e2e-307c-5119-80e4-2e681114a28a

	/// Parcels arrived from the first day of the month up to the last selected date.
	measure 'Parcels MTD' = TOTALMTD([Parcels Arrived], DimDate[Date])
		formatString: #,##0
		displayFolder: 4 Time intelligence
		lineageTag: 0b33ccfd-bfd6-5b67-a451-5a6ec6711285

	/// Parcels arrived from 1 January up to the last selected date. The first year of data starts in July.
	measure 'Parcels YTD' = TOTALYTD([Parcels Arrived], DimDate[Date])
		formatString: #,##0
		displayFolder: 4 Time intelligence
		lineageTag: 9104ed0e-786b-5cca-9af3-5b6639b2de7f

	/// Parcels arrived in the same period one year earlier. Blank where the previous year has no data (before July 2025).
	measure 'Parcels PY' = CALCULATE([Parcels Arrived], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: #,##0
		displayFolder: 4 Time intelligence
		lineageTag: ce99e7f3-ed28-5c0c-9925-6c0fa400832e

	/// Change in parcels versus the same period one year earlier, as a percentage.
	measure 'Parcels YoY %' = DIVIDE([Parcels Arrived] - [Parcels PY], [Parcels PY])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Time intelligence
		lineageTag: 19154939-5431-55bd-b93c-e9d72113d8bb

	/// Parcels arrived in the three months that end on the last selected date.
	measure 'Parcels Rolling 3M' = CALCULATE([Parcels Arrived], DATESINPERIOD(DimDate[Date], MAX(DimDate[Date]), -3, MONTH))
		formatString: #,##0
		displayFolder: 4 Time intelligence
		lineageTag: b540f190-eadd-54cf-800c-2743a15f6fa0

	/// Planned parcel volume. Targets exist per region and month, so the measure is blank when the selection is narrowed to points; select whole months for a fair comparison.
	measure 'Target Parcels' = IF(ISFILTERED(DimPickupPoint), BLANK(), SUM(Target[TargetParcels]))
		formatString: #,##0
		displayFolder: 5 Targets
		lineageTag: cda6c2dd-ee0f-58e0-86ce-7e3326a01c7f

	/// Actual parcels minus target, divided by target. Negative means below plan.
	measure 'Parcels vs Target %' = DIVIDE([Parcels Arrived] - [Target Parcels], [Target Parcels])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 5 Targets
		lineageTag: 7551d501-5b58-5ee1-8764-98ad69cdbfb0

	/// Target pickup-within-3-days rate, weighted by the planned parcels of each region and month.
	measure 'Target Pickup Within 3 Days Rate' = IF(ISFILTERED(DimPickupPoint), BLANK(), DIVIDE(SUMX(Target, Target[TargetPickup3dRate] * Target[TargetParcels]), SUM(Target[TargetParcels])))
		formatString: 0.0%
		displayFolder: 5 Targets
		lineageTag: 046fc256-2ce8-52bb-902d-d220503af0a1

	/// Pickup-within-3-days rate minus its target, in percentage points. Negative means the target is missed.
	measure 'Pickup 3D vs Target pp' = IF(ISBLANK([Target Pickup Within 3 Days Rate]), BLANK(), [Pickup Within 3 Days Rate] - [Target Pickup Within 3 Days Rate])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 5 Targets
		lineageTag: 21cb4f66-48ee-5245-9150-aa9a53331864

	/// Target return-to-sender rate, weighted by planned parcels. Lower is better.
	measure 'Target Return Rate' = IF(ISFILTERED(DimPickupPoint), BLANK(), DIVIDE(SUMX(Target, Target[TargetReturnRate] * Target[TargetParcels]), SUM(Target[TargetParcels])))
		formatString: 0.0%
		displayFolder: 5 Targets
		lineageTag: e12a05dc-1399-5863-a3c9-7520b7874a0e

	/// Share of the whole network (ALL removes the region and point filters; the date filter stays). Under row-level security the network means the regions the user may see.
	measure 'Parcels % of Network' = DIVIDE([Parcels Arrived], CALCULATE([Parcels Arrived], ALL(DimPickupPoint), ALL(DimRegion)))
		formatString: 0.0%
		displayFolder: 6 Shares
		lineageTag: 77288ab5-c96e-52d5-99c8-593177da5584

	/// Share of what the slicers currently select (ALLSELECTED keeps slicer filters and removes the visual's own row filters).
	measure 'Parcels % of Selection' = DIVIDE([Parcels Arrived], CALCULATE([Parcels Arrived], ALLSELECTED(DimPickupPoint), ALLSELECTED(DimRegion)))
		formatString: 0.0%
		displayFolder: 6 Shares
		lineageTag: 15b99685-8bae-5d2c-8d45-4af0696974b3

	/// How many points the Top N and Bottom N charts show; chosen with the Top N slicer, default 10.
	measure 'Top N Value' = SELECTEDVALUE('Top N'[Top N], 10)
		formatString: 0
		displayFolder: 7 Ranking
		lineageTag: 9d9bc69e-8d65-55f0-b070-626f5f29f536

	/// Utilisation of a point if it is among the N most utilised points of the selection, otherwise blank.
	measure 'Top N Utilisation' =
			VAR _rank =
			    RANKX(FILTER(ALLSELECTED(DimPickupPoint), DimPickupPoint[IsKnownPoint] = TRUE()), [Utilisation], , DESC, DENSE)
			RETURN
			    IF(NOT ISBLANK([Utilisation]) && _rank <= [Top N Value], [Utilisation])
		formatString: 0%
		displayFolder: 7 Ranking
		lineageTag: 9364d851-6eb1-5f5d-9a80-b19cef2e64b9

	/// Utilisation of a point if it is among the N least utilised points of the selection, otherwise blank.
	measure 'Bottom N Utilisation' =
			VAR _rank =
			    RANKX(FILTER(ALLSELECTED(DimPickupPoint), DimPickupPoint[IsKnownPoint] = TRUE() && NOT ISBLANK([Utilisation])), [Utilisation], , ASC, DENSE)
			RETURN
			    IF(NOT ISBLANK([Utilisation]) && _rank <= [Top N Value], [Utilisation])
		formatString: 0%
		displayFolder: 7 Ranking
		lineageTag: 265971d8-1578-5e3c-8059-6b724b342e3c

	/// Number of points with utilisation of 85% or more in the selected period (assumed threshold).
	measure 'Overloaded Points' =
			COUNTROWS(
			    FILTER(
			        VALUES(DimPickupPoint[PointKey]),
			        NOT ISBLANK([Utilisation]) && [Utilisation] >= 0.85
			    )
			)
		formatString: 0
		displayFolder: 7 Ranking
		lineageTag: 546f0448-97ce-5156-923c-caa78e9de456

	column Placeholder
		dataType: string
		isHidden
		lineageTag: d81eb490-c122-5f34-9772-50dee225e9eb
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source

	annotation PBI_ResultType = Table
